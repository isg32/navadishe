# Copy this file to .env.local for local `vercel dev` testing.
# In production, set these in Vercel → Project Settings → Environment Variables instead.

APPS_SCRIPT_URL=PASTE_YOUR_DEPLOYED_WEB_APP_URL_HERE

# Dashboard login credentials — a JSON object of "username":"password" pairs.
# Add/remove staff by editing this dictionary; no code changes needed.
DASHBOARD_USERS={"admin":"CHANGE_ME"}

# Random secret used to sign the dashboard's session cookie. Any long random
# string works — e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# Shared secret between Vercel and Apps Script that lets the dashboard read
# sheet rows. Set the SAME value as a Script Property named READ_KEY in the
# Apps Script project (Project Settings → Script properties) — see README §3.
SHEET_READ_KEY=PASTE_A_LONG_RANDOM_STRING_HERE
