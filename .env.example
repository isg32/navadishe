# Copy this file to .env.local for local development.
# In production, set these in Vercel → Project Settings → Environment Variables instead.
# For `vercel dev` specifically, they also need to be registered per-environment via
# `vercel env add <NAME> development` (a plain .env.local is not enough for Edge
# Functions under `vercel dev` — see README §2).

# Neon Postgres connection string — the database of record for both forms and
# for dashboard logins (app_users). Find it in the Neon console → Connection Details.
NEON_URL=PASTE_YOUR_NEON_CONNECTION_STRING_HERE

# Random secret used to sign the dashboard's session cookie. Any long random
# string works — e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# Google Apps Script web app URL — Sheets is now only an optional export
# (see "Sync to Sheets" in the dashboard), not the source of truth.
APPS_SCRIPT_URL=PASTE_YOUR_DEPLOYED_WEB_APP_URL_HERE

# Shared secret between Vercel and Apps Script that gates the sheet sync.
# Set the SAME value as a Script Property named READ_KEY in the Apps Script
# project (Project Settings → Script properties) — see README §4.
SHEET_READ_KEY=PASTE_A_LONG_RANDOM_STRING_HERE

# Only used once, by `node db/migrate.js`, to seed your first admin account
# if app_users is still empty — a JSON object of "username":"password" pairs.
# Safe to remove once you have at least one admin (create more via the
# dashboard's Users page, or `node db/create-user.js`).
DASHBOARD_USERS={"admin":"CHANGE_ME"}
